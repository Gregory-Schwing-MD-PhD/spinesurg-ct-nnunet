Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.08-py3

%labels
    Maintainer  Gregory Schwing <go2432@wayne.edu>
    Project     spinesurg-ct-nnunet
    Version     0.1.0

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # nnU-Net paths (override at runtime via SINGULARITYENV_nnUNet_*)
    export nnUNet_raw="/nnunet_nfs/raw"
    export nnUNet_preprocessed="/nnunet_nfs/preprocessed"
    export nnUNet_results="/nnunet_nfs/results"

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # System tools needed at runtime
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        rsync \
        ca-certificates \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Upgrade pip and install Python packages
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # Core ML/imaging stack (Torch is pre-installed in the NGC base image)
    pip install --no-cache-dir \
        "nnunetv2==2.5.1" \
        "nibabel>=5.2" \
        "SimpleITK>=2.3" \
        "scikit-image>=0.22" \
        "scikit-learn>=1.3" \
        "scipy>=1.11" \
        "pandas>=2.0" \
        "matplotlib>=3.7" \
        "seaborn>=0.13" \
        "tqdm>=4.66" \
        "dicom2nifti>=2.4" \
        "pydicom>=2.4"

    # Experiment tracking
    pip install --no-cache-dir \
        "wandb>=0.16" \
        "tensorboard>=2.15"

    # HF Hub (for optional in-container dataset pulls)
    pip install --no-cache-dir \
        "huggingface_hub>=0.20"

    # Make the nnU-Net variant directory writable from bind mounts
    mkdir -p /opt/conda/lib/python3.11/site-packages/nnunetv2/training/nnUNetTrainer/variants

%runscript
    echo "spinesurg-ct-nnunet container"
    echo "  nnU-Net: $(python -c 'import nnunetv2; print(nnunetv2.__version__)')"
    echo "  Torch:   $(python -c 'import torch; print(torch.__version__)')"
    echo "  CUDA:    $(python -c 'import torch; print(torch.version.cuda)')"
    echo ""
    echo "Usage:"
    echo "  singularity exec --nv spinesurg-ct.sif <command>"
    exec "$@"

%test
    python -c "import nnunetv2, torch, nibabel, SimpleITK, pandas; print('OK')"
