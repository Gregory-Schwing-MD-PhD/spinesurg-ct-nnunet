#!/bin/bash
#SBATCH --job-name=spine_pred_803
#SBATCH -q gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
#SBATCH --mem=250G
#SBATCH --gres=gpu:nvidia_h200:1
#SBATCH --time=36:00:00
#SBATCH --output=logs/spine_pred_803_%j.out
#SBATCH --error=logs/spine_pred_803_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=go2432@wayne.edu
# =============================================================================
# Stage 1 / 2: PREDICT ONLY — Dataset803 / 500ep / checkpoint_best
# =============================================================================
# Mirrors slurm/spine_train_array.sh's container-handling pattern:
# ALL preflight validation runs on the host. There is exactly ONE
# `singularity exec` in this script (the actual nnUNetv2_predict call).
#
# May 2026 — host-side validation refactor
# =========================================
# Earlier version did two probe `singularity exec` calls before launch
# (symlink-resolution probe + pymp tmpdir writability probe). On nodes
# where singularity has to convert SIF -> sandbox on first invocation,
# each probe pays that cost; on a slow/contended node the first probe
# can wedge for hours (job 36030037 sat 8.5h in the symlink probe).
# Both probes are now equivalent host-side bash:
#   - symlink probe  -> readlink each .nii.gz, translate the container
#                       path /data/hf_export/ to ${HF_EXPORT_NFS}/, stat
#                       the resolved host path
#   - pymp tmpdir    -> we mkdir'd it ourselves on the host, just touch
#                       a probe file
# These take milliseconds and don't touch singularity at all.
#
# Race-condition mitigations preserved
# ====================================
#   * SINGULARITYENV_TMPDIR -> node-local /dev/shm (NOT NFS) — avoids
#     the worker-shutdown vs queue-drain race that crashes nnU-Net v2's
#     predict at completion under -npp/-nps > 1
#   * /dev/shm bound directly (matches train script pattern)
#   * Filesystem-based completion validation (not exit code) — treats
#     post-completion multiprocessing-shutdown crash as cosmetic when
#     all output NIfTIs are present
#   * Single consolidated EXIT trap
#   * /data/hf_export bind preserved — imagesTs/*_0000.nii.gz are
#     symlinks pointing at /data/hf_export/ct/* (container path)
#
# Override at submit time:
#   sbatch --export=ALL,CHECKPOINT=checkpoint_latest.pth slurm/spine_predict_803_best.sh
# =============================================================================

set -euo pipefail

# -- Singularity / runtime dirs (matches spine_train_array.sh) ---------------
export SINGULARITY_TMPDIR="/tmp/${USER}_job_${SLURM_JOB_ID}"
export XDG_RUNTIME_DIR="${SINGULARITY_TMPDIR}/runtime"
export NXF_SINGULARITY_CACHEDIR="${HOME}/singularity_cache"
mkdir -p "${SINGULARITY_TMPDIR}" "${XDG_RUNTIME_DIR}" "${NXF_SINGULARITY_CACHEDIR}"

export CONDA_PREFIX="${HOME}/mambaforge/envs/nextflow"
export PATH="${CONDA_PREFIX}/bin:${PATH}"
unset JAVA_HOME; which singularity
export NXF_SINGULARITY_HOME_MOUNT=true
unset LD_LIBRARY_PATH PYTHONPATH R_LIBS R_LIBS_USER R_LIBS_SITE

# -- Node-local tmpfs for nnU-Net multiprocessing IPC ------------------------
# RAM-backed (/dev/shm) avoids the NFS-socket-lifecycle race that crashes
# nnU-Net v2's predict at completion under -npp/-nps > 1.
NODE_LOCAL_TMP="/dev/shm/${USER}_pymp_${SLURM_JOB_ID}"
mkdir -p "${NODE_LOCAL_TMP}"

# -- Config ------------------------------------------------------------------
DATASET_ID=803
DATASET_NAME="SpineSurgCTFullMerged"
CONFIG="3d_fullres"
TRAINER="${TRAINER:-nnUNetTrainerWandB_500ep_LSTVOversample}"
GPU_MEMORY_TARGET_GB=100
PLANS="nnUNetResEncUNetPlans_${GPU_MEMORY_TARGET_GB}G"
CHECKPOINT="${CHECKPOINT:-checkpoint_best.pth}"

NPP="${NPP:-8}"   # preprocessing workers
NPS="${NPS:-6}"   # export workers

PROJECT_ROOT="${SLURM_SUBMIT_DIR:-${HOME}/spinesurg-ct-nnunet}"
NNUNET_NFS="${PROJECT_ROOT}/nnunet"
CONTAINER="${PROJECT_ROOT}/containers/spinesurg-ct.sif"
WANDB_TRAINER_HOST="${PROJECT_ROOT}/tools/nnunet_wandb_variant.py"
WANDB_TRAINER_CONTAINER="/opt/conda/lib/python3.11/site-packages/nnunetv2/training/nnUNetTrainer/variants/nnunet_wandb_variant.py"

# -- HF export discovery (matches slurm/spine_prep.sh) -----------------------
if [[ -z "${HF_EXPORT_DIR:-}" ]]; then
    for cand in \
        "${PROJECT_ROOT}/data/hf_export" \
        "${HOME}/CTSpinoPelvic1K/data/hf_export"; do
        if [[ -d "${cand}/ct" ]]; then
            HF_EXPORT_DIR="${cand}"
            break
        fi
    done
fi
HF_EXPORT_DIR="${HF_EXPORT_DIR:-${PROJECT_ROOT}/data/hf_export}"
HF_EXPORT_NFS="${HF_EXPORT_DIR}"

DS_DIR_NAME="Dataset$(printf '%03d' ${DATASET_ID})_${DATASET_NAME}"
RUN_DIR="${NNUNET_NFS}/results/${DS_DIR_NAME}/${TRAINER}__${PLANS}__${CONFIG}"
IMAGES_TS_HOST="${NNUNET_NFS}/raw/${DS_DIR_NAME}/imagesTs"

mkdir -p "${PROJECT_ROOT}/logs"

WATCH_DONE_FLAG="${NODE_LOCAL_TMP}/.watcher_should_exit"
WATCHER_PID=""

# ----- Single consolidated trap --------------------------------------------
cleanup() {
    [[ -n "${WATCHER_PID}" ]] && { touch "${WATCH_DONE_FLAG}" 2>/dev/null || true; kill "${WATCHER_PID}" 2>/dev/null || true; }
    rm -rf "${SINGULARITY_TMPDIR}" "${NODE_LOCAL_TMP}"
}
trap cleanup EXIT

# ----- Config banner --------------------------------------------------------
echo "================================================================"
echo " SPINESURG-CT PREDICT  (Dataset${DATASET_ID} / ${CONFIG})"
echo "================================================================"
echo "  trainer       : ${TRAINER}"
echo "  plans         : ${PLANS}"
echo "  checkpoint    : ${CHECKPOINT}"
echo "  preproc workers (-npp): ${NPP}"
echo "  export workers (-nps) : ${NPS}"
echo "  project root  : ${PROJECT_ROOT}"
echo "  HF export     : ${HF_EXPORT_NFS}"
echo "  pymp tmpdir   : ${NODE_LOCAL_TMP} (node-local /dev/shm, host path)"
echo "  job id        : ${SLURM_JOB_ID:-<not in slurm>}"
echo "  node          : ${SLURMD_NODENAME:-$(hostname)}"
echo "  start time    : $(date -Iseconds)"
echo "================================================================"

# ----- Host-side preflight (no singularity exec) ----------------------------
[[ ! -f "${CONTAINER}"        ]] && { echo "ERROR: container not found: ${CONTAINER}" >&2; exit 1; }
[[ ! -f "${WANDB_TRAINER_HOST}" ]] && { echo "ERROR: trainer source not found: ${WANDB_TRAINER_HOST}" >&2; exit 1; }
[[ ! -d "${HF_EXPORT_NFS}/ct" ]] && {
    echo "ERROR: ${HF_EXPORT_NFS}/ct missing — symlinked imagesTs CTs will not resolve." >&2
    echo "  Override with HF_EXPORT_DIR=/path/to/hf_export sbatch ..." >&2
    exit 1
}
[[ ! -d "${IMAGES_TS_HOST}" ]] && {
    echo "ERROR: imagesTs not found: ${IMAGES_TS_HOST}" >&2; exit 1
}

# Verify each fold has the requested checkpoint.
echo ""
echo "Verifying checkpoints under ${RUN_DIR} ..."
MISSING=()
for F in 0 1 2 3 4; do
    FOLD_DIR="${RUN_DIR}/fold_${F}"
    if [[ ! -d "${FOLD_DIR}" ]]; then
        echo "  fold ${F}: NO FOLD DIRECTORY"
        MISSING+=(${F}); continue
    fi
    AVAIL=()
    for CKPT in checkpoint_final.pth checkpoint_best.pth checkpoint_latest.pth; do
        [[ -f "${FOLD_DIR}/${CKPT}" ]] && AVAIL+=(${CKPT})
    done
    if [[ -f "${FOLD_DIR}/${CHECKPOINT}" ]]; then
        SIZE=$(du -h "${FOLD_DIR}/${CHECKPOINT}" | cut -f1)
        MTIME=$(stat -c '%y' "${FOLD_DIR}/${CHECKPOINT}" | cut -d. -f1)
        echo "  fold ${F}: ${CHECKPOINT}  (${SIZE}, ${MTIME})  [available: ${AVAIL[*]:-none}]"
    else
        echo "  fold ${F}: requested ${CHECKPOINT} MISSING  [available: ${AVAIL[*]:-none}]"
        MISSING+=(${F})
    fi
done
if [[ ${#MISSING[@]} -gt 0 ]]; then
    echo "ERROR: folds ${MISSING[*]} are missing ${CHECKPOINT}." >&2
    echo "       Re-submit with: sbatch --export=ALL,CHECKPOINT=checkpoint_latest.pth $0" >&2
    exit 1
fi
echo "  All 5 folds have ${CHECKPOINT}."

# ----- Host-side symlink resolution probe -----------------------------------
# Replaces the previous `singularity exec ... ls` probe. Reads a sample
# of imagesTs symlinks, translates the container path
# /data/hf_export/...  -> ${HF_EXPORT_NFS}/..., and stats the host path.
# The bind mount is what makes the in-container side work; if the host
# side resolves, the bound path will too.
echo ""
echo "Probing symlink resolution on host ..."
SAMPLES=( $(find "${IMAGES_TS_HOST}" -maxdepth 1 -name "*_0000.nii.gz" 2>/dev/null | head -3) )
if [[ ${#SAMPLES[@]} -eq 0 ]]; then
    echo "ERROR: no *_0000.nii.gz files in ${IMAGES_TS_HOST}" >&2
    exit 2
fi
for SYM in "${SAMPLES[@]}"; do
    TARGET=$(readlink -f "${SYM}" 2>/dev/null || readlink "${SYM}")
    if [[ -z "${TARGET}" ]]; then
        echo "ERROR: ${SYM} is not a symlink (or readlink failed)" >&2
        exit 2
    fi
    if [[ "${TARGET}" == /data/hf_export/* ]]; then
        # Container path; translate to host
        HOST_TARGET="${HF_EXPORT_NFS}/${TARGET#/data/hf_export/}"
    else
        # Already host-resolved (readlink -f followed it)
        HOST_TARGET="${TARGET}"
    fi
    if [[ ! -f "${HOST_TARGET}" ]]; then
        echo "ERROR: symlink target unresolvable on host:" >&2
        echo "       symlink: ${SYM}" >&2
        echo "       raw    : $(readlink "${SYM}")" >&2
        echo "       host   : ${HOST_TARGET}" >&2
        echo "       This means HF_EXPORT_DIR is wrong or the dataset is missing files." >&2
        exit 2
    fi
done
echo "  symlinks resolve on host (sampled ${#SAMPLES[@]}): OK"

# ----- Host-side pymp tmpdir writability probe ------------------------------
# We mkdir'd ${NODE_LOCAL_TMP} on the host; container will see it via
# the /dev/shm bind. No need to spin up the container to verify.
if ! ( touch "${NODE_LOCAL_TMP}/.probe" && rm -f "${NODE_LOCAL_TMP}/.probe" ); then
    echo "ERROR: ${NODE_LOCAL_TMP} not writable on host." >&2
    exit 3
fi
echo "  pymp tmpdir writable on host: OK"

# ----- GPU sanity -----------------------------------------------------------
echo ""
echo "GPU visible to job:"
nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free,driver_version --format=csv | sed 's/^/  /'

# -- Singularity env ---------------------------------------------------------
# TMPDIR points at the host /dev/shm path because we bind /dev/shm:/dev/shm
# directly (matches train script). The container sees the same path on
# both sides — no /pymp_tmp indirection needed.
export SINGULARITYENV_TMPDIR="${NODE_LOCAL_TMP}"
export SINGULARITYENV_nnUNet_raw="/nnunet_nfs/raw"
export SINGULARITYENV_nnUNet_preprocessed="/nnunet_nfs/preprocessed"
export SINGULARITYENV_nnUNet_results="/nnunet_nfs/results"

# Bind layout mirrors spine_train_array.sh's TRAIN_BINDS structure.
PRED_BINDS=(
    --nv
    --bind "/dev/shm:/dev/shm"
    --bind "${PROJECT_ROOT}:/workspace"
    --bind "${HF_EXPORT_NFS}:/data/hf_export"
    --bind "${NNUNET_NFS}:/nnunet_nfs"
    --bind "${WANDB_TRAINER_HOST}:${WANDB_TRAINER_CONTAINER}"
    --pwd  /workspace
)

CKPT_TAG=$(echo "${CHECKPOINT}" | sed -e 's/checkpoint_//' -e 's/\.pth$//')
PRED_DIR_NFS="${NNUNET_NFS}/predictions/${DS_DIR_NAME}_${CONFIG}_${TRAINER}_${PLANS}_ENSEMBLE_${CKPT_TAG}"
PRED_DIR_CONT="/nnunet_nfs/predictions/${DS_DIR_NAME}_${CONFIG}_${TRAINER}_${PLANS}_ENSEMBLE_${CKPT_TAG}"
mkdir -p "${PRED_DIR_NFS}"

N_EXISTING=$({ find "${PRED_DIR_NFS}" -maxdepth 1 -name "*.nii.gz" 2>/dev/null || true; } | wc -l)
N_TEST=$({ find "${IMAGES_TS_HOST}" -maxdepth 1 -name "*_0000.nii.gz" 2>/dev/null || true; } | wc -l)
echo ""
echo "Test cases (host find): ${N_TEST}   existing predictions: ${N_EXISTING}"
echo "Output dir: ${PRED_DIR_NFS}"

if [[ "${N_EXISTING}" -ge "${N_TEST}" && "${N_TEST}" -gt 0 ]]; then
    echo "All ensemble predictions already exist; nothing to do."
    exit 0
fi

CONTINUE_FLAG=""
[[ "${N_EXISTING}" -gt 0 ]] && CONTINUE_FLAG="--continue_prediction"

# ----- Background ETA watcher ----------------------------------------------
rm -f "${WATCH_DONE_FLAG}"
(
    T_START=$(date +%s)
    LAST_N=${N_EXISTING}
    LAST_T=${T_START}
    while [[ ! -f "${WATCH_DONE_FLAG}" ]]; do
        sleep 60
        NOW=$(date +%s)
        N_CUR=$({ find "${PRED_DIR_NFS}" -maxdepth 1 -name "*.nii.gz" 2>/dev/null || true; } | wc -l)
        ELAPSED=$((NOW - T_START))
        DELTA_N=$((N_CUR - LAST_N))
        DELTA_T=$((NOW - LAST_T))
        TOTAL_DONE=$((N_CUR - N_EXISTING))
        if [[ ${ELAPSED} -gt 0 && ${TOTAL_DONE} -gt 0 ]]; then
            RATE_AVG=$(awk -v n=${TOTAL_DONE} -v t=${ELAPSED} 'BEGIN { printf "%.2f", (60.0 * n / t) }')
            REMAIN=$((N_TEST - N_CUR))
            ETA_SEC=$(awk -v r=${RATE_AVG} -v rem=${REMAIN} 'BEGIN { if (r > 0) printf "%.0f", (60.0 * rem / r); else print "?" }')
            ETA_HM=$(awk -v s=${ETA_SEC} 'BEGIN { h=int(s/3600); m=int((s%3600)/60); printf "%dh%02dm", h, m }')
        else
            RATE_AVG="—"
            ETA_HM="—"
        fi
        if [[ ${DELTA_T} -gt 0 ]]; then
            RATE_INST=$(awk -v dn=${DELTA_N} -v dt=${DELTA_T} 'BEGIN { printf "%.2f", (60.0 * dn / dt) }')
        else
            RATE_INST="—"
        fi
        printf "[watcher %s] %d/%d done (Δ%d in %ds) | rate %s/min inst, %s/min avg | ETA %s\n" \
            "$(date +%H:%M:%S)" "${N_CUR}" "${N_TEST}" "${DELTA_N}" "${DELTA_T}" \
            "${RATE_INST}" "${RATE_AVG}" "${ETA_HM}"
        LAST_N=${N_CUR}
        LAST_T=${NOW}
    done
) &
WATCHER_PID=$!

# ----- Run predict (the ONLY singularity exec in this script) ---------------
# Disable -e around nnU-Net so post-completion multiprocessing-shutdown
# crashes don't kill our wrapper before it can validate output count.
echo ""
echo "Launching nnUNetv2_predict at $(date -Iseconds) ..."
echo "----------------------------------------------------------------"
set +e
stdbuf -oL -eL singularity exec "${PRED_BINDS[@]}" "${CONTAINER}" \
    nnUNetv2_predict \
        -i  "/nnunet_nfs/raw/${DS_DIR_NAME}/imagesTs" \
        -o  "${PRED_DIR_CONT}" \
        -d  ${DATASET_ID} \
        -c  ${CONFIG} \
        -f  0 1 2 3 4 \
        -tr ${TRAINER} \
        -p  ${PLANS} \
        -chk ${CHECKPOINT} \
        -npp ${NPP} \
        -nps ${NPS} \
        --verbose \
        ${CONTINUE_FLAG}
NNUNET_EXIT=$?
set -e

# ----- Stop watcher ---------------------------------------------------------
touch "${WATCH_DONE_FLAG}"
sleep 2
kill "${WATCHER_PID}" 2>/dev/null || true
WATCHER_PID=""

# ----- Validate by filesystem, not exit code -------------------------------
sleep 5
N_FINAL=$({ find "${PRED_DIR_NFS}" -maxdepth 1 -name "*.nii.gz" 2>/dev/null || true; } | wc -l)
N_BAD=$({ find "${PRED_DIR_NFS}" -maxdepth 1 -name "*.nii.gz" -size -1k 2>/dev/null || true; } | wc -l)

echo ""
echo "================================================================"
echo " PREDICT COMPLETE  (${CHECKPOINT})  $(date -Iseconds)"
echo "================================================================"
echo "   nnUNet exit code    : ${NNUNET_EXIT}"
echo "   predictions written : ${N_FINAL} / ${N_TEST}"
echo "   suspicious files    : ${N_BAD} (zero-byte / <1KB)"
echo "   output directory    : ${PRED_DIR_NFS}"
echo ""

if [[ ${N_BAD} -gt 0 ]]; then
    echo " WARN: ${N_BAD} output files are zero-byte or <1KB; listing:" >&2
    find "${PRED_DIR_NFS}" -maxdepth 1 -name "*.nii.gz" -size -1k -ls >&2
fi

if [[ ${N_FINAL} -ge ${N_TEST} && ${N_BAD} -eq 0 ]]; then
    if [[ ${NNUNET_EXIT} -ne 0 ]]; then
        echo " NOTE: nnUNetv2_predict exited ${NNUNET_EXIT}, but all"
        echo "       ${N_FINAL}/${N_TEST} predictions are present and non-empty."
        echo "       This is a known multiprocessing-shutdown race in nnU-Net v2"
        echo "       (parent queue drain vs. worker finalizer cleanup) and is"
        echo "       cosmetic. Treating run as successful."
    fi
    echo ""
    echo " Next: run eval"
    echo "   sbatch slurm/spine_eval_803_best.sh"
    echo "================================================================"
    exit 0
elif [[ ${N_FINAL} -lt ${N_TEST} ]]; then
    echo " WARN: only ${N_FINAL} of ${N_
